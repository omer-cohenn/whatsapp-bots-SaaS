# Gateway env (NAMES ONLY — never put real values here).
# Dev: copy to gateway/.env.local (git-ignored) and fill in, OR export in your
# shell before `npm start`. The gateway REFUSES TO BOOT if GATEWAY_API_TOKEN is
# missing (no "change-me" defaults). See infra/.env.example for the full stack.

# --- Required (fail-closed) ---
GATEWAY_API_TOKEN=        # shared service token; sent as the X-Gateway-Token header. Must match the backend.

# --- Optional (have safe non-secret defaults) ---
BACKEND_WEBHOOK_URL=      # default: http://backend:8000/webhook/whatsapp  (compose service URL)
PORT=                     # default: 3000
GATEWAY_AUTH_DIR=         # default: ./auth   (gitignored Baileys creds dir; dev-spike only)
LOG_LEVEL=                # default: info
