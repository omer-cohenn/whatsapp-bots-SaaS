# Gateway-local ignores (root .gitignore also covers node_modules/ and .env.*)

# Spike Baileys auth state — MUST never be committed (session creds).
# Real design encrypts these in the DB; on disk is dev-spike only (M6).
# `auth*/` also covers backup copies (e.g. auth_corrupt_bak/ from a re-link).
auth*/
credentials/

# deps + local env
node_modules/
.env
.env.*
!.env.example
