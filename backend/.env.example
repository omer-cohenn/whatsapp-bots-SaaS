# Bizz_up backend — required env (NAMES ONLY — never put real values here).
# Copy to .env.local (git-ignored) for local dev. The app REFUSES TO BOOT if
# any required value below is missing/blank/placeholder (no "change-me" defaults).
#
# Required for the M0+M1 minimal run:
GATEWAY_API_TOKEN=     # shared service token, header-only (must match the gateway)
DATABASE_URL=          # Postgres DSN for the non-service app role, e.g. postgresql://user:pass@postgres:5432/bizzup
REDIS_URL=             # Redis URL, e.g. redis://redis:6379/0
#
# Optional (non-secret) knobs:
APP_ENV=dev            # dev | prod
LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
