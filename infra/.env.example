# Bizz_up — the ONE env template (NAMES + PLACEHOLDERS ONLY, never real secrets)
# ============================================================================
# WHAT THIS IS
#   The single source of truth for every variable the whole stack needs. It is
#   the ONLY .env template in the repo (the old per-app + per-env variants were
#   consolidated here during the security-hardening pass). It holds NO real
#   secrets and is the ONLY .env* file that is git-TRACKED.
#
# HOW TO USE
#   1) Copy this file to  infra/.env      (that real file is git-ignored)
#         cp infra/.env.example infra/.env      (PowerShell: Copy-Item)
#   2) Fill in REAL values where it says <generate> / <from ...>. Generators below.
#   3) `make dev`  (or double-click run.bat) — it passes --env-file infra/.env.
#      Raw equivalent:
#        docker compose --env-file infra/.env -f infra/docker-compose.yml up --build
#
# HARD RULES (enforced by the apps, not just here):
#   - FAIL-CLOSED: a missing/empty required value makes the app refuse to boot.
#   - NO "change-me" / constant defaults. Generate fresh, high-entropy values.
#   - NEVER reuse the old values from ..\last_bo\.env — they are COMPROMISED.
#   - In prod these come from a secret manager (AWS Secrets Manager / KMS), never
#     from a committed file.
#
# GENERATORS (any one):
#   PowerShell/bash:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Fernet keys:      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl:          openssl rand -base64 32 | tr -d '\n'; echo
# ============================================================================

# --- Gateway <-> backend shared service token (BOTH sides read this) --------
# High-entropy. The gateway sends it as header  X-Gateway-Token: <value>  on
# every inbound webhook call; the backend rejects any call without the match.
GATEWAY_API_TOKEN=<generate>

# --- Where the gateway POSTs inbound messages (the FROZEN webhook contract) --
# Inside docker-compose, services reach each other by service name, so the
# backend is "backend", not "localhost". Leave as-is for the compose run.
BACKEND_WEBHOOK_URL=http://backend:8000/webhook/whatsapp

# --- Postgres (compose builds DATABASE_URL from these three) -----------------
#   effective DATABASE_URL → postgresql://app_role:<APP_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_USER=bizzup
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=bizzup

# --- Redis (compose builds REDIS_URL from this password) ---------------------
#   effective REDIS_URL → redis://:<REDIS_PASSWORD>@redis:6379/0   (rediss:// in prod)
REDIS_PASSWORD=<generate>

# ============================================================================
# M2 — the tenant wall. The two NON-service DB role passwords + encryption keys.
# The migrate step creates app_role / gateway_role with these passwords; the
# backend connects as app_role (so RLS actually applies).
# ============================================================================
# --- Non-service DB role passwords (compose builds the DSNs from these) -------
#   DATABASE_URL          → postgresql://app_role:<APP_DB_PASSWORD>@postgres:5432/<DB>
#   GATEWAY_DATABASE_URL  → postgresql://gateway_role:<GATEWAY_DB_PASSWORD>@postgres:5432/<DB>
APP_DB_PASSWORD=<generate>
GATEWAY_DB_PASSWORD=<generate>

# --- Encryption keys (separate domains; see backend/app/core/crypto.py) -------
# PII_DATA_KEY and WA_CRED_KEK MUST be Fernet keys (urlsafe base64, 32 bytes).
PII_DATA_KEY=<generate fernet>       # encrypts lead PII (phone, name, answers)
WA_CRED_KEK=<generate fernet>        # crown-jewel KEK for the Baileys auth_state (KMS in prod)
PHONE_HMAC_KEY=<generate>            # keyed HMAC for customer_phone_hash lookups (token_urlsafe(32))

# ============================================================================
# AUTH — Google OAuth login + sessions. The backend REFUSES TO BOOT if any of
# SESSION_SECRET / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI
# is missing/blank. Get the client id/secret from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client). Add the redirect URIs below
# to "Authorized redirect URIs".
# ============================================================================
SESSION_SECRET=<generate>
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
# DEV callback (the frontend proxies /auth/* to the backend):
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
# M11 — OPTIONAL: Google Calendar/Meet connect. Leave UNSET to disable (the app
# still boots + runs). Its OWN callback must also be added in the Google console:
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/google/callback

# ============================================================================
# AI — Gemini. Powers the AI bot builder + booking welcome message
# (model: gemini-3.1-flash-lite). Get a key from Google AI Studio. OPTIONAL:
# without it the AI doors answer 503 while the rest of the stack stays up.
# ============================================================================
GEMINI_API_KEY=<from Google AI Studio>

# ============================================================================
# Back-office admin gate — OPTIONAL. Comma-separated emails granted the
# platform-operator back-office (M12/M13). Empty = no admins (NOT fail-closed).
# ============================================================================
ADMIN_EMAILS=<your admin email>

# ============================================================================
# M16 object storage. Local dev uses MinIO (S3-compatible). These are LOCAL dev
# credentials only — in prod use real S3 + an IAM role, not root creds.
# ============================================================================
MINIO_ROOT_USER=bizzup
MINIO_ROOT_PASSWORD=<generate>
S3_BUCKET=bizzup-dev
S3_REGION=us-east-1

# ============================================================================
# Non-secret operational knobs — safe explicit defaults; override only if needed.
# ============================================================================
# APP_ENV=dev                                  # dev | prod  (prod hides /docs + drops host ports)
# LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
# PUBLIC_BASE_URL=http://localhost:5173        # public base the bot links customers to (/book/{slug})
# GATEWAY_BASE_URL=http://gateway:3000         # internal gateway URL the backend proxies QR/status to
# VITE_BACKEND_URL=http://localhost:8000       # backend origin baked into the frontend DEV build
