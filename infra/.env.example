# Bizz_up — required secrets (NAMES ONLY — never put real values here)
# Copy to .env.local (git-ignored) for local dev. In prod these come from AWS Secrets Manager / KMS.
# The app + gateway REFUSE TO BOOT if any required value is missing (no "change-me" defaults).
#
# --- Database (Postgres / Supabase) ---
DATABASE_URL=                 # connection string for the NON-service app role (RLS must apply)
GATEWAY_DATABASE_URL=         # connection string for the gateway-only role (crown-jewel table)
#
# --- Redis (live-chat cache) ---
REDIS_URL=                    # rediss:// in prod (TLS)
REDIS_AUTH=                   # Redis AUTH token / password
#
# --- Auth / session (Google OAuth login) ---
SESSION_SECRET=               # high-entropy secret for the session layer (no constant default!)
GOOGLE_CLIENT_ID=             # Google OAuth client id (Google Cloud Console)
GOOGLE_CLIENT_SECRET=         # Google OAuth client secret
GOOGLE_REDIRECT_URI=          # OAuth callback URL. DEV = http://localhost:5173/auth/callback
#
# --- AI ---
GEMINI_API_KEY=               # model: gemini-3.1-flash-lite (google-genai SDK)
#
# --- Encryption keys (separate domains) ---
PII_DATA_KEY=                 # encrypts lead PII (phone, name, answers)
WA_CRED_KEK=                  # crown-jewel KEK for the Baileys auth_state (KMS in prod)
PHONE_HMAC_KEY=               # keyed HMAC for customer_phone_hash lookups
#
# --- Gateway <-> backend ---
GATEWAY_API_TOKEN=            # shared service token, header-only, high-entropy
