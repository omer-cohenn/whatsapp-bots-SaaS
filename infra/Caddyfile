# Bizz_up — production reverse proxy (the ONLY public entry point).
# ============================================================================
# Used only by infra/docker-compose.prod.yml. Everything else (postgres, redis,
# gateway, backend, the static frontend) stays on the internal Docker network and
# is NEVER published to the host — this proxy is the single door to the outside.
#
# Public surface (what the internet can reach):
#   /            -> the static frontend SPA           (service: frontend:80)
#   /api/*       -> the FastAPI backend (incl /api/book/*)  (service: backend:8000)
#   /auth/*      -> the FastAPI backend (Google OAuth)      (service: backend:8000)
#   /media/*     -> STATIC business-page gallery images     (the business_images
#                   volume, mounted read-only at /srv/business-images)
# Deliberately NOT routed here (stay internal-only): /webhook/*, /internal/*,
# /docs, /openapi.json, and the gateway's QR/dev routes.
#
# HTTPS: set PUBLIC_DOMAIN to your real domain (e.g. app.example.com) and Caddy
# gets a certificate automatically on :443. Left unset, it serves plain :80 —
# fine when TLS is terminated upstream (an ALB / CloudFront), which is the
# expected AWS posture.
# ============================================================================

{
	# No admin API exposed in production.
	admin off
}

{$PUBLIC_DOMAIN::80} {
	encode gzip

	# API + auth (this covers /api/book/* too) -> the backend, internal only.
	# Give the backend generous read time: AI (Gemini) turns can take ~10s on a
	# small server, and we don't want the proxy to cut a slow-but-valid response.
	@backend path /api/* /auth/*
	handle @backend {
		reverse_proxy backend:8000 {
			transport http {
				response_header_timeout 120s
				read_timeout 120s
			}
		}
	}

	# M20 business-page gallery images — served STATICALLY, straight off the
	# read-only business_images volume. Python is deliberately NOT in this path:
	# a 1 GB box cannot afford to stream photos through a FastAPI worker, and a
	# reverse proxy does static files far better than we ever would.
	#
	# `uri strip_prefix /media` turns /media/{business_id}/{uuid}.jpg into the
	# path {business_id}/{uuid}.jpg inside the root. file_server does NOT follow
	# ".." out of its root, and every filename in there is a server-generated
	# uuid with an extension derived from sniffed magic bytes (see
	# app/services/business_images.py) — no client-supplied name ever lands here.
	#
	# These files are immutable: a new upload gets a new uuid, and an edit is a
	# delete + re-upload. So they can be cached hard. 30 days is long enough to
	# make repeat page views free without pinning a mistake forever.
	@media path /media/*
	handle @media {
		uri strip_prefix /media
		header Cache-Control "public, max-age=2592000, immutable"
		# Belt and braces on a directory the internet reads: never let a browser
		# re-interpret a stored file as something executable.
		header X-Content-Type-Options "nosniff"
		root * /srv/business-images
		file_server {
			# No directory listings — a visitor must know the exact uuid path.
			# Without this, /media/{business_id}/ would enumerate a whole gallery.
			index ""
		}
	}

	# Everything else -> the static frontend SPA.
	handle {
		reverse_proxy frontend:80
	}
}
