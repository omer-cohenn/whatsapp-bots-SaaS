# Bizz_up — LOCAL dev env, MINIMAL set for the M0 + M1 run
# ============================================================================
# WHAT THIS IS
#   The smallest set of values needed to (a) boot the local stack and (b) prove
#   a WhatsApp message reaches the backend. The FULL list of every secret the
#   product will ever need lives in  infra/.env.example  (names only) — this
#   file is just the subset that THIS minimal run requires.
#
# HOW TO USE
#   1) Copy this file to  infra/.env.local      (that real file is git-ignored)
#         cp infra/.env.local.example infra/.env.local      (PowerShell: Copy-Item)
#   2) Fill in REAL values where it says <generate>. Use the generators below.
#   3) `make dev`   (it passes --env-file infra/.env.local for you).
#      Raw equivalent:
#        docker compose --env-file infra/.env.local -f infra/docker-compose.yml up --build
#
# HARD RULES (enforced by the apps, not just here):
#   - FAIL-CLOSED: a missing/empty required value makes the app refuse to boot.
#   - NO "change-me" / constant defaults. Generate fresh, high-entropy values.
#   - NEVER reuse the old values from ..\last_bo\.env — they are COMPROMISED.
#   - This file (the .example) holds NO real secrets. .env.local is git-ignored.
#
# GENERATORS (any one):
#   PowerShell:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   bash:        openssl rand -base64 32 | tr -d '\n'; echo
# ============================================================================

# --- Gateway <-> backend shared service token (BOTH sides read this) --------
# High-entropy. The gateway sends it as header  X-Gateway-Token: <value>  on
# every inbound webhook call; the backend rejects any call without the match.
GATEWAY_API_TOKEN=<generate>

# --- Where the gateway POSTs inbound messages (the FROZEN webhook contract) --
# Inside docker-compose, services reach each other by service name, so the
# backend is "backend", not "localhost". Leave this as-is for the compose run.
# (The compose file already defaults to this, but setting it here is explicit.)
BACKEND_WEBHOOK_URL=http://backend:8000/webhook/whatsapp

# --- Postgres (the compose builds DATABASE_URL from these three) -------------
# The backend's effective DATABASE_URL becomes:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_USER=bizzup
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=bizzup

# --- Redis (the compose builds REDIS_URL from this password) -----------------
# The backend's effective REDIS_URL becomes:
#   redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_PASSWORD=<generate>

# ============================================================================
# Everything below is NOT needed for the M0+M1 plumbing run and is intentionally
# omitted here. As features land (auth, AI, crypto, etc.) the matching names
# from infra/.env.example get added to your .env.local:
#   SESSION_SECRET, GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI, GEMINI_API_KEY,
#   PII_DATA_KEY, WA_CRED_KEK, PHONE_HMAC_KEY, GATEWAY_DATABASE_URL, REDIS_AUTH …
# Add them only when the milestone that needs them arrives — keep this minimal.
# ============================================================================
