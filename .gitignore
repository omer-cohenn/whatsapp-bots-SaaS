# --- Secrets (NEVER commit) ---
# The real infra/.env (and any .env / .env.*) stays ignored; only the secret-free
# template .env.example is tracked (copy it -> infra/.env and fill it in).
.env
.env.*
!.env.example
*.key
*.pem

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node (gateway, frontend) ---
node_modules/
dist/
build/
.vite/
npm-debug.log*

# --- WhatsApp session creds (must never be on disk in the new design) ---
credentials/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude working files (local tooling — not part of the shipped app) ---
.claude/
CLAUDE.md

# --- Internal docs (kept local, not published) ---
docs/
