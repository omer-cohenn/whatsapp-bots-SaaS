# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
# secret-free template (copy -> .env.local); the real .env.local stays ignored
!.env.local.example
*.key
*.pem

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node (gateway, frontend) ---
node_modules/
dist/
build/
.vite/
npm-debug.log*

# --- WhatsApp session creds (must never be on disk in the new design) ---
credentials/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
